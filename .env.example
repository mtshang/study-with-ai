# Local server configuration; do not use these placeholder passwords.
MYSQL_PORT=3306
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password

# Backend connection (Compose creates study_with_ai and study_app by default).
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=study_with_ai
MYSQL_USER=study_app
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Use true with HTTPS in a deployed environment.
COOKIE_SECURE=false
# USER_DATA_ROOT defaults to the project's user_data directory; normally omit it.

# The service split uses ignored .env.services generated by backend/scripts/init_service_databases.py.
# That file defines IDENTITY_MYSQL_*, LEARNING_MYSQL_*, AI_MYSQL_* and INTERNAL_SERVICE_KEY.
# For a custom environment set SERVER_ENV_FILE to its absolute path before starting services.
# Dedicated test configuration: .env.services.test. Never use it for normal development data.

# Optional AI-service MCP egress. Empty by default; configure in .env.services.
# Both values are required to enable. Only exact allowlisted hosts use the proxy.
# Proxy resolves those destinations; other hosts retain direct public-IP checks.
# MCP_HTTP_PROXY=http://127.0.0.1:7890
# MCP_PROXY_HOSTS=learn.microsoft.com
MCP_HTTP_PROXY=
MCP_PROXY_HOSTS=
